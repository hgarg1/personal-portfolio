<div id="reset-modal" class="vcs-modal-backdrop rp-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="reset-modal-title">
  <div class="vcs-modal-container rp-modal">
    <div class="rp-modal-glow" aria-hidden="true"></div>

    <div class="vcs-modal-header rp-header">
