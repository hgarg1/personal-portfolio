        <div class="rp-user-meta">
          <strong id="reset-user-name">User</strong>
          <span id="reset-user-email" class="rp-user-email">email@example.com</span>
        </div>
        <span class="rp-user-badge">Secure action</span>
      </div>

      <div class="rp-section">
        <label class="rp-section-label" id="reset-mode-label">Password mode</label>
        <div class="rp-segment" role="radiogroup" aria-labelledby="reset-mode-label">
          <label class="rp-segment-option">
            <input type="radio" name="reset-pwd-mode" value="auto" checked onchange="toggleResetPwdMode(this.value)">
            <span class="rp-segment-face">
              <span class="rp-segment-title">Auto-generate</span>
              <span class="rp-segment-desc">Cryptographically strong</span>
            </span>
          </label>
          <label class="rp-segment-option">
            <input type="radio" name="reset-pwd-mode" value="custom" onchange="toggleResetPwdMode(this.value)">
            <span class="rp-segment-face">
              <span class="rp-segment-title">Custom</span>
              <span class="rp-segment-desc">Set it yourself</span>
            </span>
          </label>
        </div>
      </div>

      <div id="reset-pwd-auto-block" class="rp-vault">
        <div class="rp-vault-top">
          <span class="rp-vault-label">Generated secret</span>
          <span class="rp-vault-strength" aria-label="Strength: strong">
            <i></i><i></i><i></i><i></i>
            <em>Strong</em>
          </span>
        </div>
        <div class="rp-secret-row">
          <input
            type="text"
            id="reset-generated-pwd-text"
            class="rp-vault-secret"
            value=""
            readonly
            spellcheck="false"
            aria-label="Generated password"
          />
          <button type="button" class="rp-vault-btn" onclick="copyResetPassword()" id="reset-copy-btn" title="Copy password">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy
          </button>
          <button type="button" class="rp-vault-btn rp-vault-btn-accent" onclick="regenResetPassword()" title="Regenerate password">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            New
          </button>
        </div>
      </div>

      <div id="reset-pwd-custom-block" class="rp-custom" hidden>
        <label class="form-label" for="reset-user-pwd">New password</label>
        <div class="rp-input-wrap">
          <input type="password" id="reset-user-pwd" class="form-input rp-input" placeholder="Min. 6 characters" autocomplete="new-password">
          <button type="button" class="rp-eye" onclick="togglePasswordVisibility('reset-user-pwd', this)" aria-label="Show password">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div class="rp-strength" aria-live="polite">
          <div class="rp-strength-bars" id="reset-strength-bars">
            <span></span><span></span><span></span><span></span>
          </div>
          <span class="rp-strength-label" id="reset-strength-label">Enter a password</span>
        </div>
      </div>

      <div class="rp-notify">
        <label class="rp-switch" for="reset-send-email">
          <input type="checkbox" id="reset-send-email" checked onchange="toggleResetEmailInputs(this.checked)">
          <span class="rp-switch-track" aria-hidden="true"><span class="rp-switch-thumb"></span></span>
          <span class="rp-switch-copy">
            <strong>Email new credentials</strong>
            <span>Deliver the temporary password to the user</span>
          </span>
        </label>
      </div>

      <div id="reset-email-inputs-block" class="rp-email-panel">
        <div class="form-group">
          <label class="form-label" for="reset-email-sub">Subject</label>
          <input type="text" id="reset-email-sub" value="Your Account Password Has Been Reset" class="form-input">
        </div>
        <div class="form-group">
          <div class="rp-preview-head">
            <label class="form-label" for="reset-email-body">Email preview</label>
            <span class="rp-preview-live">Live · macros filled</span>
          </div>
          <textarea id="reset-email-body" class="form-input rp-email-body" rows="7" spellcheck="false"></textarea>
        </div>
        <p class="rp-macros"><code>[NAME]</code>, <code>[EMAIL]</code>, and <code>[PASSWORD]</code> update automatically as you change the password.</p>
      </div>
    </div>

    <div class="vcs-modal-footer rp-footer">
      <button type="button" onclick="closeResetPasswordModal()" class="btn btn-ghost rp-btn-cancel">Cancel</button>
      <button type="button" onclick="submitResetPassword()" class="btn btn-primary rp-btn-submit" id="reset-submit-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span id="reset-submit-label">Reset Password</span>
      </button>
    </div>
  </div>
</div>

