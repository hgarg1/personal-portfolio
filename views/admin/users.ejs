        <p class="rp-eyebrow">Credential reset</p>
        <h3 id="reset-modal-title">Reset Password</h3>
      </div>
      <button type="button" class="rp-close" onclick="closeResetPasswordModal()" aria-label="Close">✕</button>
    </div>

    <div class="vcs-modal-body rp-body">
      <input type="hidden" id="reset-user-id">

      <div class="rp-user-chip" id="reset-user-chip">
