<%- include('../partials/head') %>

<section class="auth-section" aria-labelledby="authHeading">
  <div class="auth-shell">
    <aside class="auth-brand" aria-hidden="true">
      <div class="auth-brand-grid"></div>
      <div class="auth-brand-inner">
        <span class="auth-brand-mark">HG</span>
        <p class="auth-brand-title">Harshit Garg</p>
        <p class="auth-brand-desc">Connect Gmail so the site can send verification emails.</p>
      </div>
    </aside>

    <div class="auth-panel">
      <div class="auth-box">
        <header class="auth-header">
          <p class="auth-label">Email setup</p>
          <h1 class="auth-title" id="authHeading">Gmail OAuth</h1>
          <p class="auth-subtitle">Enter your Google OAuth client credentials to authorize sending.</p>
        </header>

        <% if (error) { %>
        <div class="auth-error-alert" role="alert">
          <svg class="auth-alert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span class="error-message"><%= error %></span>
        </div>
        <% } %>

        <form action="/auth/email-setup" method="POST" class="auth-form">
          <div class="form-group">
            <label for="email" class="form-label">Gmail address</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="you@gmail.com" required autofocus />
          </div>

          <div class="form-group">
            <label for="clientId" class="form-label">Client ID</label>
            <input type="text" id="clientId" name="clientId" class="form-input" placeholder="….apps.googleusercontent.com" required />
          </div>

          <div class="form-group">
            <label for="clientSecret" class="form-label">Client secret</label>
            <input type="password" id="clientSecret" name="clientSecret" class="form-input" placeholder="Enter client secret" required />
          </div>

          <button type="submit" class="btn btn-primary btn-full">
            Continue with Google
          </button>
        </form>

        <div class="auth-back-container">
          <a href="/auth" class="auth-back-link">Back to sign in</a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
