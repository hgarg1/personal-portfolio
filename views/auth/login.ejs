<%- include('../partials/head') %>

<section class="auth-section" aria-labelledby="authHeading">
  <div class="auth-shell">
    <aside class="auth-brand" aria-hidden="true">
      <div class="auth-brand-grid"></div>
      <div class="auth-brand-inner">
        <span class="auth-brand-mark">HG</span>
        <p class="auth-brand-title">Harshit Garg</p>
        <p class="auth-brand-desc">Secure access to site administration, content, and submissions.</p>
      </div>
    </aside>

    <div class="auth-panel">
      <div class="auth-box">
        <header class="auth-header">
          <p class="auth-label">Administration</p>
          <h1 class="auth-title" id="authHeading">Sign in</h1>
          <p class="auth-subtitle">Enter your credentials to continue to the dashboard.</p>
        </header>

        <div id="authAlert" class="auth-error-alert" hidden role="alert">
          <svg class="auth-alert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="authAlertMsg" class="error-message"></span>
        </div>

        <% if (error) { %>
        <div class="auth-error-alert" role="alert">
          <svg class="auth-alert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span class="error-message"><%= error %></span>
        </div>
        <% } %>

        <form id="loginForm" action="/auth/login" method="POST" class="auth-form">
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="you@example.com" autocomplete="username" required autofocus />
          </div>

          <div class="form-group" id="passwordGroup">
            <div class="form-label-row">
              <label for="password" class="form-label">Password</label>
              <button type="button" class="auth-toggle-pw" id="togglePassword" aria-label="Show password">Show</button>
            </div>
            <input type="password" id="password" name="password" class="form-input" placeholder="Enter your password" autocomplete="current-password" required />
          </div>

          <div id="passkeyBanner" class="passkey-banner" hidden>
            <svg class="passkey-banner-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
            <div class="passkey-banner-text">
              <strong>Passkey available</strong>
              <span>This account can sign in with a device passkey.</span>
            </div>
          </div>

          <button type="submit" id="submitBtn" class="btn btn-primary btn-full">
            Sign in
          </button>

          <button type="button" id="passkeyBtn" class="btn btn-primary btn-full btn-passkey" hidden>
            Continue with passkey
          </button>
        </form>

        <div id="fallbackContainer" class="auth-fallback-container" hidden>
          <button type="button" id="fallbackLink" class="auth-fallback-link">
            Use password instead
          </button>
        </div>

        <p class="auth-signup-prompt">
          Need an account? <a href="/auth/signup">Create one</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const passwordGroup = document.getElementById('passwordGroup');
  const submitBtn = document.getElementById('submitBtn');
  const passkeyBtn = document.getElementById('passkeyBtn');
  const passkeyBanner = document.getElementById('passkeyBanner');
  const fallbackContainer = document.getElementById('fallbackContainer');
  const fallbackLink = document.getElementById('fallbackLink');
  const authAlert = document.getElementById('authAlert');
  const authAlertMsg = document.getElementById('authAlertMsg');
  const togglePassword = document.getElementById('togglePassword');

  let hasPasskey = false;
  let passkeyFailedAttempts = 0;
  let checkingEmail = '';
  let passkeyBusy = false;

  function showAlert(msg) {
    authAlertMsg.textContent = msg;
    authAlert.hidden = false;
  }

  function hideAlert() {
    authAlert.hidden = true;
  }

  function setPasskeyLoading(loading) {
    passkeyBusy = loading;
    passkeyBtn.disabled = loading;
    passkeyBtn.textContent = loading ? 'Waiting for device…' : 'Continue with passkey';
  }

  function base64urlToUint8Array(base64url) {
    const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
    const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  function uint8ArrayToBase64url(buffer) {
    const base64 = window.btoa(String.fromCharCode(...new Uint8Array(buffer)));
    return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
  }

  async function checkPasskeyStatus() {
    const email = emailInput.value.trim();
    if (!email || email === checkingEmail) return;
    checkingEmail = email;

    try {
      const res = await fetch('/auth/check-passkey', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) return;
      const data = await res.json();

      hasPasskey = data.hasPasskey;
      passkeyFailedAttempts = data.failedAttempts || 0;
      updateUIState();
    } catch (err) {
      console.error('Error checking passkey:', err);
    }
  }

  emailInput.addEventListener('blur', checkPasskeyStatus);
  emailInput.addEventListener('change', checkPasskeyStatus);

  function updateUIState() {
    if (hasPasskey) {
      passkeyBanner.hidden = false;
      fallbackContainer.hidden = false;

      if (passkeyFailedAttempts < 3) {
        passwordInput.disabled = true;
        passwordInput.removeAttribute('required');
        passwordGroup.classList.add('is-locked');
        passwordInput.placeholder = 'Use passkey, or unlock with password below';

        submitBtn.hidden = true;
        passkeyBtn.hidden = false;
      } else {
        passwordInput.disabled = false;
        passwordInput.setAttribute('required', 'required');
        passwordGroup.classList.remove('is-locked');
        passwordInput.placeholder = 'Enter your password';

        submitBtn.hidden = false;
        passkeyBtn.hidden = true;
        fallbackContainer.hidden = true;

        showAlert('Passkey sign-in failed repeatedly. Please use your password.');
      }
    } else {
      passkeyBanner.hidden = true;
      fallbackContainer.hidden = true;
      passwordGroup.classList.remove('is-locked');

      passwordInput.disabled = false;
      passwordInput.setAttribute('required', 'required');
      passwordInput.placeholder = 'Enter your password';

      submitBtn.hidden = false;
      passkeyBtn.hidden = true;
    }
  }

  async function recordBiometricFailure(force = false) {
    const email = emailInput.value.trim();
    try {
      const res = await fetch('/auth/passkey/record-failure', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, force }),
      });
      if (res.ok) {
        const data = await res.json();
        passkeyFailedAttempts = data.failedAttempts;
        updateUIState();
      }
    } catch (err) {
      console.error('Error recording passkey failure:', err);
    }
  }

  async function triggerPasskeyLogin() {
    const email = emailInput.value.trim();
    if (!email || passkeyBusy) return;

    hideAlert();
    setPasskeyLoading(true);

    try {
      const optionsRes = await fetch('/auth/passkey/login-options', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      if (!optionsRes.ok) {
        const errData = await optionsRes.json();
        throw new Error(errData.error || 'Unable to start passkey sign-in.');
      }

      const options = await optionsRes.json();
      options.challenge = base64urlToUint8Array(options.challenge);
      if (options.allowCredentials) {
        options.allowCredentials.forEach(cred => {
          cred.id = base64urlToUint8Array(cred.id);
        });
      }

      const assertion = await navigator.credentials.get({ publicKey: options });
      if (!assertion) {
        throw new Error('Passkey authentication was not completed.');
      }

      const assertionForServer = {
        id: assertion.id,
        rawId: uint8ArrayToBase64url(assertion.rawId),
        type: assertion.type,
        response: {
          clientDataJSON: uint8ArrayToBase64url(assertion.response.clientDataJSON),
          authenticatorData: uint8ArrayToBase64url(assertion.response.authenticatorData),
          signature: uint8ArrayToBase64url(assertion.response.signature),
          userHandle: assertion.response.userHandle ? uint8ArrayToBase64url(assertion.response.userHandle) : null,
        },
      };

      const loginRes = await fetch('/auth/passkey/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(assertionForServer),
      });

      const loginData = await loginRes.json();

      if (loginData.verified) {
        window.location.href = '/auth/dashboard';
        return;
      }

      await recordBiometricFailure();
      showAlert(loginData.error || 'Passkey verification failed.');
    } catch (err) {
      console.error(err);
      if (err.name === 'NotAllowedError') {
        await recordBiometricFailure();
        showAlert('Passkey sign-in was cancelled or timed out.');
      } else {
        showAlert(err.message || 'Passkey sign-in failed. Please try again.');
      }
    } finally {
      setPasskeyLoading(false);
    }
  }

  passkeyBtn.addEventListener('click', triggerPasskeyLogin);

  fallbackLink.addEventListener('click', async () => {
    const ok = window.confirm(
      'Switch to password sign-in? This will unlock the password field for this account.'
    );
    if (ok) await recordBiometricFailure(true);
  });

  if (togglePassword) {
    togglePassword.addEventListener('click', () => {
      const showing = passwordInput.type === 'text';
      passwordInput.type = showing ? 'password' : 'text';
      togglePassword.textContent = showing ? 'Show' : 'Hide';
      togglePassword.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
    });
  }

  document.getElementById('loginForm').addEventListener('submit', () => {
    if (!submitBtn.hidden) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing in…';
    }
  });
});
</script>

<%- include('../partials/foot') %>
